# Copy to gateway.env (same folder) and fill in. Never commit gateway.env.

# Where the terminal connects. Use the gateway PC's LAN address to listen on
# that interface only, or 0.0.0.0 for all. The terminal's "Server Port" must
# match LISTEN_PORT.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8081

# The HRMS backend, https only. No path, no trailing slash.
UPSTREAM_URL=https://hrms-backend-XXXXXXXX.asia-south1.run.app

# The same value as ADMS_GATEWAY_TOKEN on the HRMS backend.
GATEWAY_TOKEN=

# The terminal's LAN address(es), comma separated. Give the MB360 a static IP
# or a DHCP reservation, or it will be refused after its lease changes.
ALLOWED_DEVICE_IPS=192.168.1.201

MAX_BODY_KB=1024
UPSTREAM_TIMEOUT_SECONDS=25
