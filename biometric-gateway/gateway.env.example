# Copy to gateway.env (same folder) and fill in. Never commit gateway.env.

# Where the terminal connects. 0.0.0.0 listens on every interface. The
# terminal's "Server Port" must match LISTEN_PORT.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8081

# The HRMS backend, https only. No path, no trailing slash.
UPSTREAM_URL=https://hrms-backend-XXXXXXXX.asia-south1.run.app

# The same value as ADMS_GATEWAY_TOKEN on the HRMS backend.
GATEWAY_TOKEN=

# Which callers may use the gateway, comma separated: exact IPs or IPv4 CIDR.
#
#   On an office PC: the terminal's LAN address, e.g. 192.168.1.122
#   On a cloud VM:   the office's PUBLIC address, as the gateway sees it --
#                    the terminal reaches the VM through the office router.
#                    `journalctl -u hrms-biometric-gateway` shows it under
#                    "Refused: address not allowed" until it is listed.
#   `*` accepts anyone. Only if the office address changes and cannot be
#   pinned in the cloud firewall either; the serial number is then the only
#   check, which is weaker.
ALLOWED_DEVICE_IPS=192.168.1.122

MAX_BODY_KB=1024
UPSTREAM_TIMEOUT_SECONDS=25

# Log every heartbeat as well as uploads and failures. Noisy; for debugging.
LOG_HEARTBEATS=false
