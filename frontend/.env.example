# ---------------------------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never place a secret here -- everything in this file ships to the client.
#
# Vite loads .env.development for `npm run dev` and .env.production for
# `npm run build`. This file is documentation; copy it to `.env.local` to
# override either of them on one machine without touching the committed files.
# ---------------------------------------------------------------------------

VITE_APP_NAME=HRMS

# API base URL.
#   Relative (recommended) -> resolved against the origin the app was opened
#   from and proxied by Vite. No CORS, no hardcoded host, works from any LAN
#   client automatically.
#   Absolute               -> the browser calls the API directly. Requires the
#   backend to allow that origin, and pins the address at build time.
VITE_API_URL=/api/v1

# Origin serving /uploads when VITE_API_URL is absolute. Leave blank in
# relative mode; the Vite proxy handles it.
VITE_FILE_BASE_URL=

# Dev/preview proxy target. Runs on the server machine, so loopback is right.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

VITE_API_TIMEOUT=30000
VITE_PORT=5173
VITE_PREVIEW_PORT=4173

# ---------------------------------------------------------------------------
# Containers / Cloud Run
# ---------------------------------------------------------------------------
# VITE_* values are compiled into the JavaScript when `npm run build` runs and
# are frozen from that moment. Setting one as a Cloud Run environment variable
# has NO effect -- the bundle was written long before the container started.
# They are passed as Docker build arguments instead; see cloudbuild.frontend.yaml.
#
# Keep VITE_API_URL relative (/api/v1). The frontend container's nginx proxies
# /api and /uploads to the backend, so the browser talks to one origin only:
# no CORS, and the httpOnly refresh cookie stays first-party. Pointing this at
# an absolute backend URL instead makes that cookie third-party -- blocked by
# Safari, being phased out in Chrome -- and sessions stop refreshing.
#
# The backend address is NOT set here. It is a runtime variable on the frontend
# container (BACKEND_URL), because Cloud Run only assigns the API its URL after
# the first deploy.
