# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# The code default is 8080, which is what Cloud Run and other container
# platforms inject and then probe. 5000 here is the LOCAL convention and is
# what frontend/.env.development proxies to -- change both together or the dev
# proxy stops finding the API. On Cloud Run, do NOT set PORT: the platform
# supplies it and a value here would fight it.
PORT=5000

# Bind address. 0.0.0.0 listens on every interface, which is what makes the API
# reachable from other machines on the LAN -- and what a container REQUIRES,
# since binding loopback makes the app unreachable from outside the container.
HOST=0.0.0.0

API_PREFIX=/api/v1

# How many reverse proxies sit in front, deciding which X-Forwarded-For entry
# becomes req.ip and therefore how the rate limiter buckets callers.
#   0 -> no proxy (direct)
#   1 -> one proxy: a single nginx, or Cloud Run reached directly
#   2 -> two: Cloud Run's frontend plus an nginx service ahead of it
# Too low and every caller shares one rate-limit bucket; too high and a client
# can spoof its address.
TRUST_PROXY=1

# Absolute URL of the web app, used to build links in verification and
# password-reset emails. It must be an address the RECIPIENT can open, so on a
# LAN deployment this is the server's IP -- not localhost.
CLIENT_URL=http://localhost:5173

# Database. 127.0.0.1 is correct when MongoDB runs on this same machine;
# point it at the database host otherwise.
MONGODB_URI=mongodb://127.0.0.1:27017/HRMS

# Auth - tokens
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REMEMBER_ME_EXPIRES_IN=30d
JWT_ISSUER=hrms-api
JWT_AUDIENCE=hrms-client
BCRYPT_SALT_ROUNDS=12

# Auth - account policy
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
EMAIL_VERIFICATION_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=true
MAX_ACTIVE_SESSIONS=5
PASSWORD_HISTORY_SIZE=3
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Cookies - SameSite=none REQUIRES Secure=true (cross-site production setup).
# Over plain http on a LAN leave Secure OFF: browsers silently drop a Secure
# cookie on an insecure origin, which breaks token refresh with no error.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.yourdomain.com

# Mail - leave SMTP_HOST empty to log verification/reset links instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=HRMS <no-reply@hrms.local>

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Explicit allowlist, comma separated. Always applied, in every environment.
# CLIENT_URL is added to this list automatically, so the production web origin
# only needs naming once. Not needed at all when the frontend proxies /api to
# the backend (the Cloud Run setup in DEPLOYMENT.md) -- the browser then makes
# no cross-origin request and CORS never comes into play.
CORS_ORIGINS=http://localhost:5173

# Additionally accept ANY private-network origin (localhost, 10.x, 192.168.x,
# 172.16-31.x). This is what lets every workstation on the LAN connect without
# being listed by hand. ON by default outside production and FORCED OFF when
# NODE_ENV=production, so a .env copied from a LAN install cannot widen a
# public deployment.
CORS_ALLOW_LAN=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Both accept a RELATIVE path (resolved against the backend, and the repository
# root respectively) or an ABSOLUTE one such as /mnt/employee-docs, which is
# how a container points them at a mounted volume.
#
# WARNING for Cloud Run: the container filesystem is in-memory and is destroyed
# when the instance stops, and instances do not share it. Left on local disk,
# uploaded employee documents are lost on the next deploy. See PHASE 15 in
# DEPLOYMENT.md before going live.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Employee identity documents (national ID, TIN, passport). Kept outside the
# statically served uploads directory on purpose -- these must never be
# readable by URL alone.
ATTACHMENTS_DIR=attachments
MAX_ATTACHMENT_IMAGE_MB=2
MAX_ATTACHMENT_PDF_MB=10

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=logs

# Write rotating log FILES. Correct on a server with a real disk; set false on
# Cloud Run, where the disk is in-memory and thrown away with the instance.
# stdout is collected by Cloud Logging either way.
LOG_TO_FILE=true
